# 复制为 .env 后本地调试用；GitHub Actions 上请一律配到 Settings → Secrets and variables → Actions
# 本文件只放键名，绝不放真实值；.env 已被 .gitignore 忽略。

# ---------- UUMit（必需）----------
# 取值方式：在你已接入 UUMit 的环境里执行
#   cat ~/.codebuddy/skills/uumit-agent/memory/uumit-auth.json
UUMIT_API_KEY=
UUMIT_USER_ID=
UUMIT_BASE_URL=https://api.uumit.com

# ---------- WorkBuddy 网页端（唤醒用，二选一）----------
# 推荐：Playwright storage_state.json 整体 base64（含 localStorage，比裸 cookie 活得久）
#   base64 -w0 wb_storage_state.json
WB_STORAGE_STATE_B64=
# 次选：F12 → Network → 任意请求 → Request Headers → cookie 整行复制
WB_COOKIE=
# 可选：直接指定会话页 URL，命中则优先用
WB_CHAT_URL=

# ---------- 兜底通知（可选，配几个用几个）----------
TG_BOT_TOKEN=
TG_CHAT_ID=
BARK_KEY=
BARK_SERVER=https://api.day.app
SERVERCHAN_KEY=
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ---------- 行为参数 ----------
POLL_INTERVAL=60
WAKE_COOLDOWN=900
MAX_ITEMS=8
DRY_RUN=0
